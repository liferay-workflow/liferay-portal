<workflow-definition>
	<name>Workflow Definition with & characters</name>
	<description>Sample to a workflow content with & inside.</description>
	<state>
		<name>created</name>
		<initial>true</initial>
		<transitions>
			<transition>
				<name>created_review_review</name>
				<target>review</target>
				<default>true</default>
			</transition>
		</transitions>
	</state>
	<state>
		<name>approved</name>
		<actions>
			<action>
				<name>approve</name>
				<status>0</status>
				<execution-type>onEntry</execution-type>
			</action>
			<script>
				<![CDATA[String document = "This & shouldn't be mapped by the regex"]]>
			</script>
			<script-language>groovy</script-language>
		</actions>
		<labels>
			<label language-id="en_US">
				approved
			</label>
		</labels>
	</state>
	<task>
		<name>review</name>
		<actions>
			<notification>
				<name>Review Notification</name>
				<template>
					<![CDATA[${userName} sent you a ${entryType} for r&view ]]>
				</template>
				<template-language>freemarker</template-language>
				<notification-type>email</notification-type>
				<notification-type>user-notification</notification-type>
				<recipients receptionType="to">
					<assignees />
				</recipients>
				<execution-type>onAssignment</execution-type>
			</notification>
		</actions>
		<assignments>
			<roles>
				<role>
					<role-type>account</role-type>
					<name>Account Administrator &</name>
				</role>
			</roles>
		</assignments>
		<transitions>
			<transition>
				<name>approve</name>
				<target>approved</target>
				<default>true</default>
			</transition>
		</transitions>
	</task>
</workflow-definition>