if (ctx._source.versions instanceof String) {
	def versions = new HashSet();

	versions.add(ctx._source.versions);
	versions.add(params.version);

	ctx._source.versions = versions;
}
else {
	def version = ctx._source.versions.find(
		version -> version.equals(params.version));

	if (version == null) {
		ctx._source.versions.add(params.version);
	}
}